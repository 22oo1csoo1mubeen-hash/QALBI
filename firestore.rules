rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── User Profile Documents: /users/{userId} ─────────────────────────────
    match /users/{userId} {
      // Owner only: Protects user's email, settings, and private account metadata from exposure
      allow read: if isOwner(userId);

      // Create: user must be authenticated, creating their own UID, with no passwords/tokens
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.username is string
                    && request.resource.data.username.size() >= 3
                    && request.resource.data.username.size() <= 20
                    && !('password' in request.resource.data)
                    && !('passwordHash' in request.resource.data)
                    && !('token' in request.resource.data);

      // Update: owner only; UID and createdAt cannot be modified; credentials forbidden
      allow update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && !('password' in request.resource.data)
                    && !('passwordHash' in request.resource.data);

      // Delete: owner only
      allow delete: if isOwner(userId);

      // FCM Device Tokens: /users/{userId}/fcmTokens/{tokenId}
      match /fcmTokens/{tokenId} {
        // Only the authenticated device owner can register or remove their tokens
        allow read, write: if isOwner(userId);
      }
    }

    // ─── Username Registry: /usernames/{usernameNormalized} ──────────────────
    match /usernames/{username} {
      // Authenticated users can check availability
      allow read: if isAuthenticated();

      // Create: claim allowed ONLY if document does NOT exist and UID matches authenticated user
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && username.size() >= 3
                    && username.size() <= 20
                    && !exists(/databases/$(database)/documents/usernames/$(username));

      // Prevent arbitrary clients from modifying or overwriting registered usernames
      allow update: if false;

      // Only the owning user can delete their claim
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ─── Minimal Public Profiles: /publicProfiles/{userId} ───────────────────
    match /publicProfiles/{userId} {
      // Any authenticated user can read public profile summaries for pairing display
      allow read: if isAuthenticated();

      // Only owner can create or update their public profile; no sensitive fields permitted
      allow create, update: if isOwner(userId)
                            && request.resource.data.uid == userId
                            && request.resource.data.username is string
                            && !('email' in request.resource.data)
                            && !('password' in request.resource.data);

      allow delete: if isOwner(userId);
    }

    // ─── Temporary Pairing Codes: /pairingCodes/{code} ───────────────────────
    match /pairingCodes/{code} {
      // Disallow list queries across entire collection to prevent code harvesting/enumeration
      allow list: if false;

      // Allow single document lookup by exact code by authenticated users
      allow get: if isAuthenticated();

      // Create: authenticated user creates code with own creatorUid and status ACTIVE
      allow create: if isAuthenticated()
                    && request.resource.data.creatorUid == request.auth.uid
                    && request.resource.data.code == code
                    && request.resource.data.status == "ACTIVE"
                    && code.size() == 8;

      // Update:
      // Case 1: Creator revoking their active code
      // Case 2: Another authenticated user (not the creator) redeeming an active code
      allow update: if isAuthenticated() && (
        (resource.data.creatorUid == request.auth.uid && request.resource.data.status == "REVOKED")
        ||
        (resource.data.status == "ACTIVE"
         && resource.data.creatorUid != request.auth.uid
         && request.resource.data.status == "REDEEMED"
         && request.resource.data.redeemedBy == request.auth.uid)
      );

      // Delete: owner only
      allow delete: if isAuthenticated() && resource.data.creatorUid == request.auth.uid;
    }

    // ─── Friend Connections: /connections/{connectionId} ─────────────────────
    match /connections/{connectionId} {
      // Only connection members can read their connection
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberUids;

      // Create: requester must be one of the members, exactly 2 members, status CONNECTED
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.memberUids
                    && request.resource.data.memberUids.size() == 2
                    && request.resource.data.status == "CONNECTED";

      // Disconnect: only connection members can delete the connection
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.memberUids;

      // Connections cannot be updated arbitrarily
      allow update: if false;
    }

    // ─── User Block List: /userBlocks/{blockerUid}/blockedUsers/{blockedUid} ─
    match /userBlocks/{blockerUid}/blockedUsers/{blockedUid} {
      // Only the blocking user can read or write their own block list
      allow read, write: if isAuthenticated() && request.auth.uid == blockerUid;
    }

    // ─── Wake-Up Requests: /wakeUpRequests/{requestId} ──────────────────────
    match /wakeUpRequests/{requestId} {
      // Only the sender or receiver can view a request
      allow read: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );

      // Create: Authenticated sender, valid recipient, status PENDING
      allow create: if isAuthenticated()
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.receiverUid != request.auth.uid
                    && request.resource.data.status == "PENDING"
                    && request.resource.data.requestId == requestId
                    && request.resource.data.createdAt != null
                    && request.resource.data.expiresAt != null;

      // Update: Atomic lifecycle transitions
      allow update: if isAuthenticated()
                    // Immutable fields check
                    && request.resource.data.requestId == resource.data.requestId
                    && request.resource.data.senderUid == resource.data.senderUid
                    && request.resource.data.receiverUid == resource.data.receiverUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (
                      // 1. Receiver acknowledges
                      (
                        resource.data.status == "PENDING"
                        && request.auth.uid == resource.data.receiverUid
                        && request.resource.data.status == "ACKNOWLEDGED"
                        && request.resource.data.acknowledgedAt != null
                      )
                      ||
                      // 2. Receiver declines
                      (
                        resource.data.status == "PENDING"
                        && request.auth.uid == resource.data.receiverUid
                        && request.resource.data.status == "DECLINED"
                        && request.resource.data.declinedAt != null
                      )
                      ||
                      // 3. Sender cancels
                      (
                        resource.data.status == "PENDING"
                        && request.auth.uid == resource.data.senderUid
                        && request.resource.data.status == "CANCELLED"
                        && request.resource.data.cancelledAt != null
                      )
                      ||
                      // 4. Mark expired
                      (
                        resource.data.status == "PENDING"
                        && (request.auth.uid == resource.data.senderUid || request.auth.uid == resource.data.receiverUid)
                        && request.resource.data.status == "EXPIRED"
                      )
                    );

      // Requests are persistent records; cannot be deleted arbitrarily by clients
      allow delete: if false;
    }

    // ─── Default Deny ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
