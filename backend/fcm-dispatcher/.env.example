# Local setup: copy this file to .env and keep the real .env out of Git.
# Put the Firebase service-account JSON beside dispatcher.js for local use.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Render sets PORT automatically. This value is only for running locally.
PORT=3000

# In Render Dashboard, set GOOGLE_APPLICATION_CREDENTIALS to:
# /etc/secrets/serviceAccountKey.json
